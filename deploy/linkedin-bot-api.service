[Unit]
Description=LinkedIn bot: API de métricas (solo lectura)
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
ExecStart=__APP_DIR__/.venv/bin/python -m bot serve
Restart=always
RestartSec=5
MemoryMax=80M

[Install]
WantedBy=multi-user.target

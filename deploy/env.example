# Configuración del bot en la VM. Sin comillas ni espacios alrededor del "=".
# Proxy principal y de reserva: ip:puerto (las credenciales comunes van abajo) o http://usuario:contraseña@ip:puerto
PROXY_PRIMARY=46.203.60.237:7237
PROXY_SECONDARY=46.203.76.67:6567
PROXY_USER=
PROXY_PASS=

# Perfil persistente del navegador: aquí queda guardada la sesión de LinkedIn tras "bash deploy/login.sh"
CHROME_PROFILE_DIR=__HOME__/linkedin-profile

PYTHONUNBUFFERED=1

# API de métricas (deploy/METRICS.md). Genera el token con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
METRICS_HOST=127.0.0.1
METRICS_PORT=8787
METRICS_TOKEN=
# 1 = /api/summary sin token (no contiene datos de personas). Pon tu dominio en METRICS_CORS si quieres restringirlo.
METRICS_PUBLIC=1
METRICS_CORS=*
